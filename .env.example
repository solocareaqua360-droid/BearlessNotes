# Copy this file to .env and fill in real values from Firebase Console
# (Project settings → General → Your apps → Bearless Notes Web → SDK setup and configuration).
# .env is git-ignored on purpose — never commit real keys.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Public by design - the OAuth client the app signs in as. Lives in the
# DRIVE Cloud project, not the Firebase one: see utils/googleClient.ts.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
