{
  "expo": {
    "name": "mindEva",
    "slug": "bearless-notes",
    "version": "1.0.0",
    "scheme": "mindeva",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "mindEva використовує Face ID для захисту застосунку від стороннього доступу"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1839",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      // DeX and any other desktop window: without this Android refuses the
      // app a real window and upscales a phone-sized one instead, which is
      // why the interface looked like stretched pixels there rather than
      // like itself at a larger size.
      "resizeableActivity": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.bearlessnotes.notes",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "mindEva потребує доступу до камери, щоб сканувати документи"
        }
      ],
      [
        "expo-splash-screen",
        {
          // The launcher's own background, so the icon on the splash is
          // the same icon in the same colours the morph starts from -
          // against the gradient's brown it read as a white-edged tile
          // dropped onto a different screen.
          "backgroundColor": "#0F1839",
          // Required, not optional: with only a width the plugin still
          // points the generated theme at a drawable it never writes, and
          // the build fails linking it.
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-notifications",
      "expo-audio",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "*/*"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "video/*",
            "*/*"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "862729ab-f7db-43fc-9615-ec489deeb26d"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/862729ab-f7db-43fc-9615-ec489deeb26d"
    }
  }
}
