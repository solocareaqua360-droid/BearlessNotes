{
  "expo": {
    "name": "mindEva",
    "slug": "bearless-notes",
    "version": "1.0.0",
    "scheme": "mindeva",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "mindEva використовує Face ID для захисту застосунку від стороннього доступу"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1839",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      // DeX and any other desktop window: without this Android refuses the
      // app a real window and upscales a phone-sized one instead, which is
      // why the interface looked like stretched pixels there rather than
      // like itself at a larger size.
      "resizeableActivity": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.bearlessnotes.notes",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "mindEva потребує доступу до камери, щоб сканувати документи"
        }
      ],
      [
        "expo-splash-screen",
        {
          // The colour the first screen's gradient starts with, so the
          // splash doesn't flash a different background before the app
          // draws - see App.tsx's own stand-in view, which uses the same.
          "backgroundColor": "#705648",
          "imageWidth": 200
        }
      ],
      "expo-notifications",
      "expo-audio",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "*/*"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "video/*",
            "*/*"
          ]
        }
      ],
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "862729ab-f7db-43fc-9615-ec489deeb26d"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/862729ab-f7db-43fc-9615-ec489deeb26d"
    }
  }
}
