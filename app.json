{
  "expo": {
    "name": "viBo",
    "slug": "bearlessnotes",
    "scheme": [
      "bearlessnotes",
      "com.bearlessnotes.app"
    ],
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F5F2",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bearlessnotes.app"
    },
    "android": {
      "package": "com.bearlessnotes.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2B1770"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "./plugins/withPictureInPicture.js",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "a5702ee7-33d8-47bf-bcc0-bb5c59951f1b",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ShareExtension",
                  "bundleIdentifier": "com.bearlessnotes.app.share-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.bearlessnotes.app"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a5702ee7-33d8-47bf-bcc0-bb5c59951f1b",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    }
  }
}
