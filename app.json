{
  "expo": {
    "name": "sketchEva",
    "slug": "sketch-eva",
    "version": "0.1.0",
    "scheme": "sketcheva",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E1E1C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "resizeableActivity": true,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.sketcheva.app",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E1E1C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8e98e142-c50b-47a5-b7fc-b86424271cc0"
      }
    },
    "owner": "alexgoran",
    "updates": {
      "url": "https://u.expo.dev/8e98e142-c50b-47a5-b7fc-b86424271cc0"
    },
    "ios": {}
  }
}
