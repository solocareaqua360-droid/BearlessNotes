<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Playing in the background: a foreground service of the media-playback
       type keeps the process (and the video's sound) alive with the screen
       off, and shows the notification with the player's buttons. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application>
    <service
      android:name="expo.modules.cinemanative.MediaPlaybackService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />
  </application>
</manifest>
